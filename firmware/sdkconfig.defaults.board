# Real Waveshare ESP32-S3-Touch-LCD-3.5B overlay. Wi-Fi connectivity, longer
# production intervals, test hooks compiled out. See
# docs/hardware/board-spec-constraints.md for the peripheral/PSRAM rationale.
CONFIG_AGENT_WIDGET_PLATFORM_BOARD=y
CONFIG_AGENT_WIDGET_PLATFORM_QEMU=n

CONFIG_ESP_WIFI_ENABLED=y

CONFIG_AGENT_WIDGET_SELFTEST_WINDOW_SEC=30
CONFIG_AGENT_WIDGET_CHECK_INTERVAL_SEC=3600

CONFIG_AGENT_WIDGET_TEST_HOOKS=n

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
